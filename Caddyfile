# SITE_ADDRESS is the public hostname (e.g. app.example.com) -> automatic HTTPS.
# Use ":80" for a local, plain-HTTP trial of the production stack.
{$SITE_ADDRESS:localhost} {
	encode gzip zstd

	# API docs are not served in prod; block them at the edge as well.
	@blocked path /docs* /swagger-ui* /v3/api-docs*
	handle @blocked {
		respond 404
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /actuator/health {
		reverse_proxy backend:8080
	}

	# Hashed build assets: a missing file must be a real 404, not index.html
	# (a stale tab would otherwise get HTML for a JS chunk).
	handle /assets/* {
		root * /srv
		file_server
	}

	# Everything else: SPA fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
